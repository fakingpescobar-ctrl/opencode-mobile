# Шаблон релизной подписи. Скопируй в `keystore.properties` (тот файл в .gitignore) и
# заполни под свой ключ. `keystore.properties` и сам `.jks` НИКОГДА не коммитить.
#
# Сгенерировать ключ:
#   keytool -genkeypair -v -keystore ~/keys/opencode-release.jks -storetype PKCS12 \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias opencode-release
#
# Ключ держи ВНЕ репозитория. Потерянный ключ = невозможность выпустить обновление:
# Play потребует нового приложения с другим applicationId. Делай бэкап.
#
# storeFile - путь к .jks. Поддерживаются прямой и файловый URL, так что на CI можно
# указать «file:///run/secrets/release.jks».
storeFile=/absolute/path/to/opencode-release.jks
storePassword=CHANGE_ME
keyAlias=opencode-release
keyPassword=CHANGE_ME
