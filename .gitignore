# Build artifacts
.gradle/
build/
/cmake-build-*/
*.so
*.a
*.apk
*.aab
*.keystore
*.jks

# Binary model / engine (rebuilt or downloaded, too big for git)
app/src/main/assets/*.bin
app/src/main/jniLibs/

# CMake / NDK generated
**/.cxx/
**/.externalNativeBuild/
**/prefab_config.json
**/compile_commands.json
**/ncnn-host-build/
**/encdump-test/

# Tool caches
.cache/
.kotlin/

# IDE
*.iml
.idea/
.DS_Store
.vscode/

# Local config
local.properties

# Release
/app/release/

# Large third-party (not in git)
/third_party/
/tools/ncnn-convert/

# Big int8-quant artifacts (weights ~2.8GB, regenerable via quantize_block.py)
/tools/ncnn-int8/turbo/
/tools/ncnn-int8/**/*.bin
/tools/ncnn-int8/**/*.npy
/tools/ncnn-int8/**/*.table

# Logs
*.log
/build_log.txt

# Local build/device artifacts
/build-inst.err
/opencode.jsonc.device

# Release signing secrets (keystore itself lives outside the repo).
# *.keystore / *.jks above cover the container; this covers the passwords.
keystore.properties
